class SportsClub:

    def __init__(self):
        # dictionary to store members
        self.members = {}

    def menu(self):
        print("\n===== Sports Club =====")
        print("1. Add Member")
        print("2. Update Training Status")
        print("3. View Members")
        print("4. Exit")

    # add a new club member
    def add_member(self):
        name = input("Enter Member's Name: ")
        sport = input("Enter Sport's Name: ")
        coach = input("Enter Sport's Coach Name: ")
        period = input("Enter Training Period: ")
        fee = input("Enter Membership Fee (Rs.): ")

        self.members[name] = {
            "sport": sport,
            "coach": coach,
            "period": period,
            "status": "In Progress",
            "fee": fee
        }

        print("✅ Member Added Successfully!!")

    # update training status
    def update_status(self):
        name = input("Enter Member's Name: ")

        if name not in self.members:
            print("❌ Member Not Found!!")
            return

        print("1. In Progress")
        print("2. Completed")

        choice = input("Enter Choice: ")

        if choice == "2":
            self.members[name]["status"] = "Completed"
        else:
            self.members[name]["status"] = "In Progress"

        print("✅ Status Updated Successfully!!")

    # display all members
    def view_members(self):
        if not self.members:
            print("❌ No Members Found!!")
            return

        print("\n===== Members List =====")

        for name, m in self.members.items():
            print(f"""
👤 Name: {name}
🏅 Sport: {m["sport"]}
👨‍🏫 Coach: {m["coach"]}
📅 Period: {m["period"]}
📌 Status: {m["status"]}
💰 Fee: Rs.{m["fee"]}
""")

    # run the application loop
    def run(self):
        while True:
            self.menu()
            choice = input("Choose: ")

            if choice == "1":
                self.add_member()
            elif choice == "2":
                self.update_status()
            elif choice == "3":
                self.view_members()
            elif choice == "4":
                print("👋 See you next training!")
                break
            else:
                print("❌ Invalid Choice!!")


# start the app
club = SportsClub()
club.run()
